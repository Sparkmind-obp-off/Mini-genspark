{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vestrenhq-private-preview",
  "account_id": "a167a50f1272635d3c1145aab3cd8f98",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/privacy", "/terms", "/support", "/pricing", "/status"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "vestrenhq-private-preview",
    "database_id": "86787a64-0479-4ee6-96ca-5e9387a9b781",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "DEPLOYMENT_STAGE": "private-preview",
    "DAILY_REQUEST_LIMIT": "20",
    "LLM_PROVIDER": "cloudflare",
    "FREE_PLAN_CONFIRMED": "false",
    "GROQ_FREE_PLAN_CONFIRMED": "false",
    "TAVILY_FREE_PLAN_CONFIRMED": "false",
    "SEARCH_MONTHLY_LIMIT": "100"
  },
  "observability": { "enabled": false }
}
