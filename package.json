{
  "name": "mini-genspark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A free-tier-first personal AI workspace.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "dev:worker": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply mini-genspark --local"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.40.0"
  }
}
